{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scottnaddle/coursespec/schema/coursespec.schema.json",
  "title": "CourseSpec v0.2",
  "description": "LMS 중립 과정 설계서. 교수자 워크스페이스의 원본(source of truth)이며, 퍼블리셔가 Moodle·Canvas 등으로 배포한다. 날짜는 절대 날짜가 아니라 과정 시작일 기준 상대 일수(day)로 적는다.",
  "type": "object",
  "required": [
    "coursespec",
    "id",
    "title",
    "units"
  ],
  "additionalProperties": false,
  "properties": {
    "coursespec": {
      "enum": [
        "0.1",
        "0.2"
      ],
      "description": "스펙 버전. 0.2는 0.1의 상위 호환(materials, 수업 참조 추가)."
    },
    "id": {
      "$ref": "#/$defs/id",
      "description": "설계서의 영구 식별자. 배포된 활동의 ID number에 심어 재배포 시 매칭에 쓴다."
    },
    "version": {
      "type": "string",
      "description": "설계서 버전 (예: 0.3.0). 배포 기록에 남는다."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "shortname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "default": "ko"
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Seoul",
      "description": "IANA 시간대. day 오프셋을 실제 시각으로 바꿀 때 쓴다."
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcome"
      },
      "description": "학습목표. 활동·평가가 outcomes로 참조하며 린트가 구성적 정렬을 점검한다."
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      },
      "description": "자료 매니페스트. 교수자 자료를 단원·학습목표와 연결하고, 콘텐츠 생성(OpenMAIC)·튜터 지식베이스(DeepTutor)·학습자 배포 중 어디에 쓸 수 있는지 밝힌다."
    },
    "grading": {
      "$ref": "#/$defs/grading"
    },
    "policies": {
      "$ref": "#/$defs/policies"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "badges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/badge"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "description": "소문자·숫자·하이픈. 설계서 안에서 유일해야 한다."
    },
    "day": {
      "type": "integer",
      "minimum": 1,
      "description": "과정 시작일을 1일차로 하는 상대 일수"
    },
    "html_or_markdown": {
      "type": "string"
    },
    "extensions": {
      "type": "object",
      "description": "특정 LMS 전용 설정. 퍼블리셔가 그대로 전달한다 (예: moodle.settings, canvas.assignment).",
      "properties": {
        "moodle": {
          "type": "object"
        },
        "canvas": {
          "type": "object"
        }
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "outcome": {
      "type": "object",
      "required": [
        "id",
        "statement"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "remember",
            "understand",
            "apply",
            "analyze",
            "evaluate",
            "create"
          ],
          "description": "블룸 개정 분류 수준"
        }
      }
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "enum": [
            "weighted_mean",
            "natural",
            "mean"
          ],
          "default": "weighted_mean"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "description": "백분율 기준 가중치"
              }
            }
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_minutes_per_unit": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "unit": {
      "type": "object",
      "required": [
        "id",
        "title",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "$ref": "#/$defs/html_or_markdown"
        },
        "opens_day": {
          "$ref": "#/$defs/day"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "이 단원을 열기 위해 완료해야 할 활동 id"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "completion": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "manual",
            "view",
            "submit",
            "grade",
            "pass",
            "posts"
          ]
        },
        "pass_grade": {
          "type": "number",
          "minimum": 0
        },
        "posts": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "item_grading": {
      "type": "object",
      "required": [
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "category": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "rubric": {
      "type": "object",
      "required": [
        "name",
        "criteria"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "description",
              "levels"
            ],
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "levels": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "definition",
                    "score"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "definition": {
                      "type": "string",
                      "minLength": 1
                    },
                    "score": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "text",
              "file"
            ]
          },
          "uniqueItems": true
        },
        "max_files": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "multichoice",
            "truefalse",
            "shortanswer",
            "essay"
          ]
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "mark": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "feedback": {
          "type": "string",
          "description": "일반 피드백"
        },
        "multiple": {
          "type": "boolean",
          "default": false,
          "description": "multichoice: 정답이 여러 개"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "correct": {
                "type": "boolean",
                "default": false
              },
              "feedback": {
                "type": "string"
              }
            }
          }
        },
        "answer": {
          "type": "boolean",
          "description": "truefalse: 정답"
        },
        "accepted_answers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "shortanswer: 인정 답안"
        },
        "case_sensitive": {
          "type": "boolean",
          "default": false
        },
        "grader_info": {
          "type": "string",
          "description": "essay: 채점자 안내"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "page",
            "file",
            "assignment",
            "quiz",
            "discussion",
            "peer_review",
            "wiki",
            "glossary",
            "survey",
            "h5p",
            "interactive_lecture"
          ],
          "description": "앞의 5개는 공통 코어, 나머지는 확장 유형이며 LMS에 따라 변환되거나 배포되지 않을 수 있다 (docs/lms-mapping.md)."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "$ref": "#/$defs/html_or_markdown"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "visible": {
          "type": "boolean",
          "default": true
        },
        "opens_day": {
          "$ref": "#/$defs/day"
        },
        "due_day": {
          "$ref": "#/$defs/day"
        },
        "cutoff_day": {
          "$ref": "#/$defs/day"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "completion": {
          "$ref": "#/$defs/completion"
        },
        "grading": {
          "$ref": "#/$defs/item_grading"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "content": {
          "$ref": "#/$defs/html_or_markdown",
          "description": "page"
        },
        "content_format": {
          "enum": [
            "markdown",
            "html"
          ],
          "default": "markdown"
        },
        "video_url": {
          "type": "string",
          "format": "uri"
        },
        "source": {
          "type": "string",
          "description": "file·h5p: 파일 URL 또는 워크스페이스 상대 경로 (file 은 material 로 대신할 수 있음)"
        },
        "filename": {
          "type": "string"
        },
        "submission": {
          "$ref": "#/$defs/submission"
        },
        "rubric": {
          "$ref": "#/$defs/rubric"
        },
        "quiz": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "time_limit_minutes": {
              "type": "integer",
              "minimum": 1
            },
            "attempts": {
              "type": "integer",
              "minimum": 0,
              "description": "0 = 무제한"
            },
            "grade_method": {
              "enum": [
                "highest",
                "average",
                "first",
                "last"
              ]
            }
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "discussion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": {
              "enum": [
                "general",
                "qanda"
              ]
            }
          }
        },
        "peer_review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assessment_max": {
              "type": "number",
              "minimum": 0,
              "description": "평가 활동 자체의 점수"
            },
            "assessment_due_day": {
              "$ref": "#/$defs/day"
            }
          }
        },
        "wiki": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "collaborative",
                "individual"
              ]
            }
          }
        },
        "survey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "anonymous": {
              "type": "boolean"
            }
          }
        },
        "lecture": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "engine": {
              "enum": [
                "openmaic"
              ],
              "default": "openmaic"
            },
            "prompt": {
              "type": "string",
              "description": "수업 생성 요구사항. 학습목표·단원 정보는 퍼블리셔가 덧붙인다."
            },
            "materials": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "description": "생성에 쓸 자료 id"
            },
            "min_progress": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "classroom": {
              "type": "object",
              "required": [
                "id"
              ],
              "additionalProperties": false,
              "description": "생성된 수업의 기록. 생성 계획 실행 후 패치로 채워진다.",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "OpenMAIC classroomId"
                },
                "server": {
                  "type": "string",
                  "description": "수업이 있는 OpenMAIC 서버 이름(비밀값 아님)"
                },
                "dsl_version": {
                  "type": "string"
                },
                "generated_at": {
                  "type": "string"
                },
                "archive": {
                  "type": "string",
                  "description": "수업 ZIP 내보내기 경로. 워크스페이스에서 버전 관리"
                }
              }
            },
            "exports": {
              "type": "object",
              "additionalProperties": false,
              "description": "상호작용 수업을 지원하지 않는 LMS용 대체 산출물",
              "properties": {
                "html": {
                  "type": "string"
                },
                "video": {
                  "type": "string"
                },
                "pptx": {
                  "type": "string"
                }
              }
            }
          }
        },
        "material": {
          "$ref": "#/$defs/id",
          "description": "file: source 대신 자료 매니페스트의 자료를 배포"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "page"
              }
            }
          },
          "then": {
            "required": [
              "content"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "h5p"
              }
            }
          },
          "then": {
            "required": [
              "source"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "file"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "source"
                ]
              },
              {
                "required": [
                  "material"
                ]
              }
            ]
          }
        }
      ]
    },
    "badge": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "criteria"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "min_course_grade": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "material": {
      "type": "object",
      "required": [
        "id",
        "title",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "document",
            "slides",
            "video",
            "audio",
            "web",
            "dataset",
            "other"
          ],
          "default": "document"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "워크스페이스 상대 경로 또는 URL. 학생 개인정보가 담긴 자료는 넣지 않는다."
        },
        "language": {
          "type": "string"
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "관련 단원 id"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "관련 학습목표 id"
        },
        "uses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "generation",
              "tutor",
              "learner"
            ]
          },
          "description": "generation: 콘텐츠 생성 입력, tutor: 튜터 지식베이스, learner: 학습자에게 배포 가능"
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owner": {
              "type": "string"
            },
            "license": {
              "type": "string",
              "description": "예: own, cc-by-4.0, internal-only, publisher-licensed"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "자료 버전 고정용 해시"
        }
      }
    }
  }
}
